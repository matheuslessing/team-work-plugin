{
  "teamwork-guardrails": {
    "SessionStart": [
      {
        "type": "command",
        "command": "node ./scripts/hooks-engine.mjs SessionStart --adapter antigravity",
        "timeout": 10
      }
    ],
    "PreToolUse": [
      {
        "matcher": "edit|write_file|edit_file|write_to_file|replace_file_content|multi_replace_file_content|delete_file|exec|run_command|bash|shell",
        "hooks": [
          {
            "type": "command",
            "command": "node ./scripts/hooks-engine.mjs PreToolUse --adapter antigravity",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "edit|write_file|edit_file|write_to_file|replace_file_content|multi_replace_file_content|delete_file|exec|run_command|bash|shell",
        "hooks": [
          {
            "type": "command",
            "command": "node ./scripts/hooks-engine.mjs PostToolUse --adapter antigravity",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "node ./scripts/hooks-engine.mjs Stop --adapter antigravity",
        "timeout": 10
      }
    ]
  }
}
