{
  "SessionStart": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "node \"${PLUGIN_ROOT}/scripts/hooks-engine.mjs\" SessionStart",
          "timeout": 5
        }
      ]
    }
  ],
  "UserPromptSubmit": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "node \"${PLUGIN_ROOT}/scripts/hooks-engine.mjs\" UserPromptSubmit",
          "timeout": 5
        }
      ]
    }
  ],
  "PreToolUse": [
    {
      "matcher": "*",
      "hooks": [
        {
          "type": "command",
          "command": "node \"${PLUGIN_ROOT}/scripts/hooks-engine.mjs\" PreToolUse",
          "timeout": 5
        }
      ]
    }
  ],
  "PostToolUse": [
    {
      "matcher": "*",
      "hooks": [
        {
          "type": "command",
          "command": "node \"${PLUGIN_ROOT}/scripts/hooks-engine.mjs\" PostToolUse",
          "timeout": 5
        }
      ]
    }
  ],
  "PostCompaction": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "node \"${PLUGIN_ROOT}/scripts/hooks-engine.mjs\" PostCompaction",
          "timeout": 5
        }
      ]
    }
  ],
  "Stop": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "node \"${PLUGIN_ROOT}/scripts/hooks-engine.mjs\" Stop",
          "timeout": 5
        }
      ]
    }
  ]
}
