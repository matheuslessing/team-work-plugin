{
  "$schema": "../../../packages/core/schemas/skill-contract.v1.json",
  "name": "team-status",
  "version": "2.0.0",
  "description": "Render live outcome Threads, Attention queue, Skill-BOM summary, and Gate status from view.json and state.json.",
  "token_budget_tier": "low",
  "eligibility": {
    "phases": ["INIT", "SURVEY", "CONTRACT_FROZEN", "DUAL_TRACK", "GATE", "REMEDIATION", "VICTORY_AUDIT", "DONE", "FAILED", "MANUAL"],
    "runtimes": ["DEVIN_CLI_LOCAL", "DEVIN_CLOUD", "ANTIGRAVITY"]
  },
  "P_preconditions": [],
  "O_operation": {
    "authority_profile": "read_only",
    "allowed_write_globs": [".agents/teamwork/view.json"],
    "denied_shell_patterns": ["git\\s+(commit|push|reset|checkout)"],
    "program_functions": []
  },
  "A_artifacts": [
    { "path": ".agents/teamwork/view.json", "required": false }
  ],
  "V_validators": [
    { "cmd": "node ${PLUGIN_ROOT}/scripts/teamwork-cli.mjs status --workdir ." }
  ],
  "F_failure_modes": [
    { "code": "NO_WORKSPACE", "action": "NOOP", "route_to": "team-craft" }
  ],
  "ecosystem_edges": {
    "depends_on": [],
    "compatible_with": ["team-run", "team-board", "team-gate"],
    "redundant_with": [],
    "alternative_to": [],
    "lineage": "team-status@1.0.0"
  }
}
