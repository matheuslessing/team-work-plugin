{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://teamwork-suite.dev/schemas/doc-frontmatter.v1.json",
  "title": "PMSP Memory Document Frontmatter",
  "type": "object",
  "required": ["id", "kind", "status", "summary", "tags", "source_refs"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "kind": {
      "type": "string",
      "enum": ["architecture", "decision", "contract", "gotcha"]
    },
    "status": {
      "type": "string",
      "enum": ["active", "stale", "superseded", "deprecated"]
    },
    "supersedes": {
      "type": ["string", "null"]
    },
    "summary": {
      "type": "string",
      "minLength": 10,
      "maxLength": 240
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "symbols": { "type": "array", "items": { "type": "string" } },
          "sha256_prefix": { "type": "string" }
        }
      }
    },
    "last_verified_commit": { "type": ["string", "null"] },
    "token_estimate": { "type": "integer", "minimum": 1 }
  }
}
