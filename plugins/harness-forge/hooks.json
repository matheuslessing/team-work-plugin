{
  "PreToolUse": [
    {
      "matcher": ".*",
      "hooks": [
        {
          "type": "command",
          "command": "node \"${PLUGIN_ROOT}/scripts/hooks-engine.mjs\" PreToolUse",
          "timeout": 5
        }
      ]
    }
  ],
  "PostToolUse": [
    {
      "matcher": ".*",
      "hooks": [
        {
          "type": "command",
          "command": "node \"${PLUGIN_ROOT}/scripts/hooks-engine.mjs\" PostToolUse",
          "timeout": 10
        }
      ]
    }
  ],
  "Stop": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "node \"${PLUGIN_ROOT}/scripts/hooks-engine.mjs\" Stop",
          "timeout": 10
        }
      ]
    }
  ]
}
